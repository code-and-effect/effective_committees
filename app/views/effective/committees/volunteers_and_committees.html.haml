= render('layout') do
  - @committees.each do |committee|
    %h3= committee
    = committee.body

    - members = committee.committee_members.select(&:active?).uniq(&:user_id)
    %ul
      - members.each do |member|
        %li
          = member.user.to_s
          - if member.category.present?
            = badge(member.category)

      - if members.blank?
        %li No #{committee_members_label.downcase}
